all: vanilla-test

# makefile-./ is a dummy string, not a directory
.PHONY: makefile-tests
.SILENT: $(MK_TEST_DIRS:%=%/Makefile)
makefile-tests: $(MK_TEST_DIRS:%=makefile-./%)
prep: $(MK_TEST_DIRS:%=%/Makefile)
	@echo "All Makefiles generated."

.PHONY: force-create
# this target actually emits Makefile files
%/Makefile: force-create
	+@cd $* && python3 generate_mk.py $(if $(SEED),-S$(SEED))

makefile-./%: %/Makefile
	@$(MAKE) -C $*
	@echo "...passed tests in $*"

.PHONY: functional
functional:
ifeq ($(ENABLE_FUNCTIONAL_TESTS),1)
	-@cd functional && ./run-test.sh
endif

# Shell tests of ours that must EXECUTE - named here, not left to a glob.
#
# A `.sh` under tests/<dir> runs only because tests/<dir>/generate_mk.py passes
# `--bash`, and the Makefile that carries the resulting target is GENERATED and
# gitignored. So nothing tracked in this tree records that these two files are
# supposed to run: delete that one flag from techmap/generate_mk.py and every
# shell test in techmap stops running while `make vanilla-test` still exits 0.
# A green that means nothing is worse than a red.
#
# Two assertions, because either one alone can be fooled:
#   collected - the generated Makefile really carries a target for the file.
#               Regenerated by `prep` on every run, so it cannot go stale, and
#               it is what catches a dropped `--bash`.
#   ran       - common.mk's run_test wrote <test>.result. A target that exists
#               and executes nothing leaves no result file; that is exactly how
#               a suite can be "reachable" and still never run.
SHELL_TESTS =
SHELL_TESTS += techmap/merge_liberty.sh
SHELL_TESTS += various/read_activity_err.sh

.PHONY: check-shell-tests
check-shell-tests:
	@rc=0; \
	for t in $(SHELL_TESTS); do \
		d=`dirname $$t`; f=`basename $$t`; \
		if ! grep -q "^$$f:" $$d/Makefile 2>/dev/null; then \
			echo "NOT COLLECTED: tests/$$t has no target in tests/$$d/Makefile"; \
			echo "               (does $$d/generate_mk.py still pass --bash?)"; \
			rc=1; \
		elif [ ! -f $$t.result ]; then \
			echo "DID NOT RUN: tests/$$t left no $$f.result"; \
			rc=1; \
		else \
			echo "`cat $$t.result` tests/$$t"; \
		fi; \
	done; \
	test $$rc -eq 0

vanilla-test: prep makefile-tests functional
	@echo ""
	@echo "  Passed \"make vanilla-test\"."
ifeq ($(ENABLE_VERIFIC),1)
ifeq ($(YOSYS_NOVERIFIC),1)
	@echo "  Ran tests without verific support due to YOSYS_NOVERIFIC=1."
endif
endif
	@echo ""
# Both, always, and fail if either did: `summary` answers "did the tests pass",
# `check-shell-tests` answers "did these ones run at all". Chaining them with a
# plain && would let the second hide the first's report of what failed.
	@rc=0; \
	$(MAKE) --no-print-directory summary || rc=$$?; \
	$(MAKE) --no-print-directory check-shell-tests || rc=$$?; \
	exit $$rc

clean:
	@rm -rf ./asicworld/*.out ./asicworld/*.log
	@rm -rf ./hana/*.out ./hana/*.log
	@rm -rf ./simple/*.out ./simple/*.log
	@rm -rf ./memories/*.out ./memories/*.log ./memories/*.dmp
	@rm -rf ./sat/*.log ./techmap/*.log ./various/*.log
	@rm -rf ./bram/temp ./fsm/temp ./realmath/temp ./share/temp ./smv/temp ./various/temp
	@rm -f ./svinterfaces/*.log_stdout ./svinterfaces/*.log_stderr ./svinterfaces/dut_result.txt ./svinterfaces/reference_result.txt ./svinterfaces/a.out ./svinterfaces/*_syn.v ./svinterfaces/*.diff
	@rm -f  ./tools/cmp_tbdata
	@rm -f $(addsuffix /Makefile,$(MK_TEST_DIRS))
	@find . -name '*.result' -type f -exec rm -f {} +

.PHONY: coverage
coverage:
	@echo "Creating coverage HTML & Codecov report"
	@$(YOSYS) -qp 'help; help -all'
	@rm -rf $(COVERAGE_HTML)
	@llvm-profdata merge -sparse $(COVERAGE_DIR)/coverage_*.profraw -o $(COVERAGE_DIR)/yosys.profdata
	@llvm-cov export $(YOSYS) -instr-profile=$(COVERAGE_DIR)/yosys.profdata -format=lcov --compilation-dir=$(SRC_DIR) --ignore-filename-regex='(^|.*/)libs/.*|/usr/include/.*|$(subst /,\/,$(VERIFIC_DIR))/.*' > $(BUILD_DIR)/coverage.info
	@llvm-cov show $(YOSYS) -instr-profile=$(COVERAGE_DIR)/yosys.profdata -format=html -output-dir=$(COVERAGE_HTML) --compilation-dir=$(SRC_DIR) --ignore-filename-regex='(^|.*/)libs/.*|/usr/include/.*|$(subst /,\/,$(VERIFIC_DIR))/.*'

.PHONY: clean_coverage
clean_coverage:
	@echo "Clean coverage"
	@rm -rf $(COVERAGE_DIR)
