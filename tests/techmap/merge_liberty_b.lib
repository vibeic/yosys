library(demo) {
  time_unit : "1ns";
  lu_table_template(t2x2) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.5");
    index_2 ("0.001, 0.05");
  }
  cell(BUF) {
    area : 2.5;
    cell_leakage_power : 0.9;
    pin(A) { direction : input; capacitance : 0.006; max_transition : 1.2; }
    pin(Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.35;
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(t2x2)      { values("0.90, 0.12", "0.31, 0.99"); }
        cell_fall(t2x2)      { values("0.91, 0.19", "0.13, 0.99"); }
        rise_transition(t2x2){ values("0.95, 0.04", "0.97, 0.08"); }
      }
    }
  }
  cell(DFF) {
    area : 9.5;
    ff(IQ,IQN) { next_state : "D"; clocked_on : "CK"; }
    pin(CK) { direction : input; clock : true; capacitance : 0.003; }
    pin(D) {
      direction : input;
      capacitance : 0.002;
      timing() {
        related_pin : "CK";
        timing_type : setup_rising;
        rise_constraint(t2x2) { values("0.19, 0.25", "0.20, 0.24"); }
      }
    }
    pin(Q) { direction : output; function : "IQ"; }
  }
}
