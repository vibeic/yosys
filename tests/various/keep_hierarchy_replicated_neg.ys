# vibeic id-9 proven-negative: the CEC miter in keep_hierarchy_replicated.ys is
# not a rubber stamp. The gate here has one output bus inverted (a 1-bit-class
# functional difference); the same miter+sat MUST find a counter-example. We run
# 'sat -verify' (which ABORTS on a failed proof) and assert via 'logger -expect
# error' that it does abort -- so the test PASSES precisely when non-equivalence
# is correctly detected.

logger -expect error "Called with -verify and proof did fail!" 1

read_verilog <<EOF
module leaf(input a, input b, output y);
	assign y = a ^ b;
endmodule

module bigblk(input [7:0] a, input [7:0] b, output [7:0] s);
	assign s = (a * b) + (a ^ b) + (a & b);
endmodule

// GOLD: correct top
module gold(input [15:0] a, input [15:0] b, output [7:0] y, output [7:0] s);
	wire [7:0] t;
	genvar i;
	generate for (i=0;i<8;i=i+1) begin: g
		leaf u(.a(a[i]), .b(b[i]), .y(t[i]));
	end endgenerate
	assign y = t;
	bigblk bb(.a(a[7:0]), .b(b[7:0]), .s(s));
endmodule

// GATE: identical but with the y output bus inverted (injected 1-bit-class fault)
module gate(input [15:0] a, input [15:0] b, output [7:0] y, output [7:0] s);
	wire [7:0] t;
	genvar i;
	generate for (i=0;i<8;i=i+1) begin: g
		leaf u(.a(a[i]), .b(b[i]), .y(t[i]));
	end endgenerate
	assign y = ~t;
	bigblk bb(.a(a[7:0]), .b(b[7:0]), .s(s));
endmodule
EOF

hierarchy
proc
opt_clean
# run both sides through the -max_instances policy + flatten (leaf is replicated
# across gold+gate, so it is kept; -min_cost is omitted as it needs a single top)
keep_hierarchy -max_instances 1
flatten
setattr -mod -unset keep_hierarchy
flatten
opt_clean

miter -equiv -make_assert -flatten gold gate miter
sat -verify -prove-asserts -show-ports miter
