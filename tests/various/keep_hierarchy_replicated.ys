# vibeic id-9: replication-aware selective boundary optimization.
#
# 'keep_hierarchy -min_cost' keeps modules by SIZE only. A small module that is
# instantiated many times (replicated) falls below the size threshold and is
# dissolved into every parent by a following 'flatten' -- duplicating its logic
# N times and destroying the single boundary that lets it be uniquified/mapped
# once. The new '-max_instances' flag is the "keep replicated" half of the
# commercial 'ungroup -small' policy. This test proves both the behaviour and
# that the marking is function-preserving (unfakeable CEC + proven-negative is
# in keep_hierarchy_replicated_neg.ys).

read_verilog <<EOF
module leaf(input a, input b, output y);
	assign y = a ^ b;
endmodule

module bigblk(input [7:0] a, input [7:0] b, output [7:0] s);
	assign s = (a * b) + (a ^ b) + (a & b);
endmodule

module top(input [15:0] a, input [15:0] b, output [7:0] y, output [7:0] s);
	wire [7:0] t;
	genvar i;
	generate for (i=0;i<8;i=i+1) begin: g
		leaf u(.a(a[i]), .b(b[i]), .y(t[i]));
	end endgenerate
	assign y = t;
	bigblk bb(.a(a[7:0]), .b(b[7:0]), .s(s));
endmodule
EOF

hierarchy -top top
proc
opt_clean
design -save start

# --- BASELINE (FAIL): size-only policy dissolves the small replicated leaf ---
keep_hierarchy -min_cost 40
flatten
select -assert-mod-count 0 leaf
select -assert-mod-count 1 bigblk

# --- FIX (PASS): replication awareness keeps the leaf as one boundary ---
design -load start
keep_hierarchy -min_cost 40 -max_instances 1
flatten
select -assert-mod-count 1 leaf
select -assert-mod-count 1 bigblk

# --- CEC: the -max_instances policy + flatten preserves function ---
# gold = plain full flatten
design -load start
flatten
opt_clean
rename top gold
design -stash gold
# gate = -max_instances policy + partial flatten, then fully flattened for the solver
design -load start
keep_hierarchy -min_cost 40 -max_instances 1
flatten
setattr -mod -unset keep_hierarchy
flatten
opt_clean
rename top gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -make_assert -flatten gold gate miter
sat -verify -prove-asserts -show-ports miter
