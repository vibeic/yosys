# An SVA assertion must be attributed to the property it was written from, not
# to the module header.
#
# `opt_sva_label' is an EMPTY nonterminal when the assertion carries no label,
# and an empty nonterminal's location collapses to the end of the last token
# actually consumed -- the module header's `;'. So `@$' on these productions
# begins on the module line, and everything anchored on it followed: the `\src'
# attribute, the autogenerated cell name, and the two new diagnostics
# ("used before it is declared", "`|=>' needs a clocking event").
#
# Measured before the fix: `\src' was "<<EOT:1.42-4.42", i.e. a span starting on
# the module line, and the errors were reported on line 1. A LABELLED assertion
# was already correct, which is what made this easy to miss -- so both spellings
# are checked here.
#
# `\src' is the observable that pins this down from a .ys test: `logger -expect
# error' matches the message body without the `file:line' prefix, so the error
# line itself cannot be asserted, but it comes from the same location and moves
# with it.

# ---------------------------------------------------------------------------
# unlabelled: the assertion is on line 4, not line 1
# ---------------------------------------------------------------------------
read_verilog -formal -sv <<EOT
module top (input clk, input a, input b);


	assert property (@(posedge clk) a |-> b);
endmodule
EOT
hierarchy -top top
proc
select -assert-count 1 t:$check
select -assert-count 1 t:$check a:src=<<EOT:4.* %i
# and NOT the module header -- without this the check above would still pass if
# every cell in the design were selected
select -assert-count 0 t:$check a:src=<<EOT:1.* %i

# ---------------------------------------------------------------------------
# a named property is attributed to the instantiation, the same way
# ---------------------------------------------------------------------------
design -reset
read_verilog -formal -sv <<EOT
module top (input clk, input a, input b);
	property p_ab;
		@(posedge clk) a |-> b;
	endproperty


	assert property (p_ab);
endmodule
EOT
hierarchy -top top
proc
select -assert-count 1 t:$check
select -assert-count 1 t:$check a:src=<<EOT:7.* %i
select -assert-count 0 t:$check a:src=<<EOT:1.* %i

# ---------------------------------------------------------------------------
# the labelled spelling, which was already correct and must stay that way
# ---------------------------------------------------------------------------
design -reset
read_verilog -formal -sv <<EOT
module top (input clk, input a, input b);


	a_lbl: assert property (@(posedge clk) a |-> b);
endmodule
EOT
hierarchy -top top
proc
select -assert-count 1 t:$check
select -assert-count 1 t:$check a:src=<<EOT:4.* %i
