# The cover spelling of the same defect. This one is the worst shape: the
# property can NEVER be true, yet the dangling wire made the cover reachable, so
# a coverage report claimed a scenario was exercised that the design cannot even
# express.
logger -expect error "SVA property .p_hit. cannot be instantiated inside a procedural block" 1
read_verilog -formal -sv <<EOT
module top (input clk, input a);
	wire imposs = 1'b0;
	property p_hit;
		@(posedge clk) a && imposs;
	endproperty
	always @(posedge clk) c_proc: cover property (p_hit);
endmodule
EOT
