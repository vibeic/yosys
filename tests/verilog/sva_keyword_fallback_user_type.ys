# `endproperty' and `disable iff' are keywords only under `-formal'. Outside
# formal mode they must fall back to the WHOLE identifier rule -- `isUserType'
# lookup included -- not merely to TOK_ID.
#
# A name reached through the keyword rule that returns TOK_ID where the
# identifier rule would have returned TOK_USER_TYPE turns a file that used to
# parse into a syntax error. Measured before this fix, both modules below were
# rc 1 with "syntax error, unexpected TOK_ID, expecting ')' or ',' or '='",
# while the same file with the type named anything else was rc 0.
read_verilog -sv <<EOT
typedef logic endproperty;
module top_ep (output endproperty a);
	assign a = 1'b0;
endmodule
EOT
hierarchy -top top_ep
select -assert-count 1 w:a

# `disable' reaches the same fallback through the `disable iff' rule, which
# yyless()es the `iff' back before falling through. The port really has to be
# named `iff': the rule's trailing context means `iff_x' would never match it.
design -reset
read_verilog -sv <<EOT
typedef logic disable;
module top_di (output disable iff);
	assign iff = 1'b0;
endmodule
EOT
hierarchy -top top_di
select -assert-count 1 w:iff

# The control: with `-formal' both words ARE keywords, and the same input is a
# hard error. Without this the test above would also be satisfied by dropping
# the formal-mode gate.
design -reset
logger -expect error "unexpected TOK_ENDPROPERTY" 1
read_verilog -formal -sv <<EOT
typedef logic endproperty;
module top_ep (output endproperty a);
	assign a = 1'b0;
endmodule
EOT
