# A concurrent assertion written INSIDE a procedural block names a property that
# this front end cannot lower there: a named property is expanded at its point of
# use into an `always' block of its own, and there is no way to reconcile that
# with the enclosing procedural block.
#
# Nothing used to look the name up, so `p_req_ack' silently became an implicitly
# declared, undriven wire and the tool proved something other than what was
# written -- a false alarm for assert, a fake green for cover, a silently dropped
# constraint for assume. A clear refusal is honest; silently proving the wrong
# thing is not.
logger -expect error "SVA property .p_req_ack. cannot be instantiated inside a procedural block" 1
read_verilog -formal -sv <<EOT
module top (input clk, input req);
	wire ack = req;
	property p_req_ack;
		@(posedge clk) req |-> ack;
	endproperty
	always @(posedge clk) a_proc: assert property (p_req_ack);
endmodule
EOT
